{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "FreakingJSON",
  // Skills nativas del framework: OpenCode escanea `**/SKILL.md` bajo cada path.
  // Se registran desde el propio repo (alcance de framework, no global).
  "skills": {
    "paths": ["core/skills/core"]
  },
  // El plugin de integración vive en `.opencode/plugins/` y OpenCode lo carga
  // automáticamente. La lista `plugin` es para paquetes npm, no para archivos locales.
  "mcp": {
    // Servidores MCP DESACTIVADOS por defecto (ahorro de ~6K tokens de contexto
    // inicial + no requieren Node). Para reactivar: cambia "enabled" a true.
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": { "DEFAULT_MINIMUM_TOKENS": "" },
      "enabled": false
    },
    "sequentialthinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false
    },
    "github-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE" },
      "enabled": false
    }
  }
}
