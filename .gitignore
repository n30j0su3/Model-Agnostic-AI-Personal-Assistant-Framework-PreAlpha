# === PA Framework Pre-Alpha — .gitignore ===

# System / IDE
.env
node_modules/
__pycache__/
*.pyc
*.log
.vscode/
.idea/

# AI CLI internal dirs (generated at runtime)
.claude/
.codex/
.opencode/package-lock.json
.opencode/temp-quota/
.opencode/*.tmp

# Privacy — User data (NEVER commit)
core/.context/profile.md
core/.context/sessions/
core/.context/codebase/
core/.context/backups/
core/.context/env_vars.json
core/.context/opencode.md
core/.context/claude.md
core/.context/gemini.md
core/.context/MASTER.md
core/.context/projects/
core/.context/vitals/
core/.context/knowledge_base.json
core/.context/knowledge/insights/
core/.context/knowledge/learning/
core/.context/knowledge/self-healing/
core/.context/knowledge/prompts/
core/.context/knowledge/sessions-index.json
core/.context/knowledge/knowledge-index.json

# Old root-level context (legacy)
.context/
sessions/
logs/

# User workspaces (private content)
workspaces/*/

# Config with secrets
opencode.jsonc
config/mcp.json
config/quotas.json

# Temp / dev artifacts
TEMPO/
_bmad/
_bmad-output/
*.tmp
.last_sync
.update-preservation/

# Local dev notes (keep out of releases)
PRE-ALPHA.txt
DIAGNOSTICO-DEV.txt
ResultadoPruebasMVP-Personal.txt
DELEGACION_CODEX.md
PLAN_EVOLUCION_UX.md
PLAN_SISTEMICO_INTEGRACION.md
opencode.jsonc.nanogpt.jsonc
opencode.jsonc_bk
opencode.jsonc.template
idea-chat.png

# VITALS - Backups históricos y snapshots (solo local, nunca en git)
vitals/

# Documentación técnica avanzada (solo BASE, no PROD)
docs/technical/

# Obsolete/Historical (preserved but excluded from sync)
OBSOLETE/

# Obsoleto - Internal/obsolete files (excluded from git)
Obsoleto/
RELEASE-STAGING/

# Sanitized templates for sync (never commit)
core/.context/codebase/.sanitized/
